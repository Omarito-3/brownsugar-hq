# Postgres connection string. Locally this can be any Postgres; in production
# use the Neon *pooled* connection string (the host containing "-pooler").
DATABASE_URL="postgresql://user:password@localhost:5432/brownsugar_hq?schema=public"

# Session signing secret. Generate with: npx auth secret
AUTH_SECRET="generate-with-npx-auth-secret"

# Vercel Blob read/write token, for receipt and document uploads.
# Vercel injects this automatically once a Blob store is connected to the
# project; only set it by hand for local development.
BLOB_READ_WRITE_TOKEN=""

# Shared secret for the scheduled exchange-rate refresh at /api/cron/rates.
# Vercel Cron sends it as "Authorization: Bearer $CRON_SECRET".
# If unset the endpoint is UNPROTECTED — always set it in production.
CRON_SECRET=""

# Optional. Overrides the exchange-rate provider endpoint. Leave unset to use
# the default (open.er-api.com), which needs no API key.
# EXCHANGE_RATES_URL=""
