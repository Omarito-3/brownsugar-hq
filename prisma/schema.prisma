generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  MANAGER
  STAFF
}

enum ProductCategory {
  BUBBLE_TEA
  COFFEE
  FOOD
  OTHER
}

enum ExpenseCategory {
  RENT
  SUPPLIES
  SALARY
  MARKETING
  EQUIPMENT
  OTHER
}

enum Unit {
  KG
  G
  L
  ML
  PIECE
  PACK
}

enum StockMovementType {
  PURCHASE
  CONSUMPTION
  WASTE
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
}

enum AdjustmentDirection {
  INCREASE
  DECREASE
}

enum EmployeePosition {
  BARISTA
  CASHIER
  SHIFT_LEAD
  BRANCH_MANAGER
  CLEANER
  OTHER
}

enum ShiftType {
  MORNING
  EVENING
  FULL_DAY
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum DocumentCategory {
  CONTRACT
  LICENSE
  TENDER
  INVOICE
  INSURANCE
  OTHER
}

enum CampaignChannel {
  INSTAGRAM
  FACEBOOK
  TIKTOK
  IN_STORE
  INFLUENCER
  OTHER
}

enum ExperimentStatus {
  IDEA
  TESTING
  LAUNCHED
  REJECTED
}

enum FeedbackSource {
  IN_PERSON
  INSTAGRAM
  GOOGLE_REVIEW
  OTHER
}

enum FeedbackSentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

enum StockLocationType {
  WAREHOUSE
  BRANCH
}

enum StockRequestStatus {
  PENDING
  APPROVED
  FULFILLED
  REJECTED
}

model Branch {
  id        String   @id @default(cuid())
  name      String
  location  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  users           User[]
  branchProducts  BranchProduct[]
  salesEntries    SalesEntry[]
  expenses        Expense[]
  stockLocations  StockLocation[]
  employees       Employee[]
  tasks           Task[]
  documents       Document[]
  campaigns       Campaign[]
  menuExperiments MenuExperiment[]
  feedback        Feedback[]
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(STAFF)
  branchId     String?
  createdAt    DateTime @default(now())

  branch            Branch?         @relation(fields: [branchId], references: [id])
  salesEntries      SalesEntry[]
  expenses          Expense[]
  stockMovements    StockMovement[]
  tasksAssigned     Task[]          @relation("TaskAssignee")
  tasksCreated      Task[]          @relation("TaskCreator")
  documentsUploaded Document[]
  stockRequestsMade StockRequest[]  @relation("StockRequestRequester")
  stockRequestsSeen StockRequest[]  @relation("StockRequestReviewer")
}

model Product {
  id           String          @id @default(cuid())
  name         String
  nameAr       String?
  category     ProductCategory
  basePriceIls Decimal         @db.Decimal(10, 2)
  costIls      Decimal?        @db.Decimal(10, 2)
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())

  branchProducts BranchProduct[]
  salesLineItems SalesLineItem[]
}

model BranchProduct {
  id               String   @id @default(cuid())
  branchId         String
  productId        String
  isAvailable      Boolean  @default(true)
  priceOverrideIls Decimal? @db.Decimal(10, 2)

  branch  Branch  @relation(fields: [branchId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([branchId, productId])
}

model Currency {
  code          String    @id
  rateToIls     Decimal   @db.Decimal(10, 4)
  updatedAt     DateTime  @updatedAt
  /// When false the rate is held manually (agreed supplier/shop rate) and the
  /// scheduled fetch leaves it alone.
  isAutoUpdated Boolean   @default(true)
  /// Last time a live fetch actually wrote this rate.
  lastFetchedAt DateTime?

  expenses             Expense[]
  salesCurrencyAmounts SalesCurrencyAmount[]
}

model SalesEntry {
  id          String   @id @default(cuid())
  branchId    String
  date        DateTime @db.Date
  totalIls    Decimal  @db.Decimal(10, 2)
  orderCount  Int
  notes       String?
  enteredById String
  createdAt   DateTime @default(now())

  branch          Branch                @relation(fields: [branchId], references: [id])
  enteredBy       User                  @relation(fields: [enteredById], references: [id])
  lineItems       SalesLineItem[]
  currencyAmounts SalesCurrencyAmount[]

  @@unique([branchId, date])
}

model SalesLineItem {
  id           String @id @default(cuid())
  salesEntryId String
  productId    String
  quantity     Int

  salesEntry SalesEntry @relation(fields: [salesEntryId], references: [id])
  product    Product    @relation(fields: [productId], references: [id])
}

model SalesCurrencyAmount {
  id             String  @id @default(cuid())
  salesEntryId   String
  currencyCode   String
  amountOriginal Decimal @db.Decimal(10, 2)
  amountIls      Decimal @db.Decimal(10, 2)

  salesEntry SalesEntry @relation(fields: [salesEntryId], references: [id])
  currency   Currency   @relation(fields: [currencyCode], references: [code])

  @@unique([salesEntryId, currencyCode])
}

model Expense {
  id             String          @id @default(cuid())
  branchId       String
  date           DateTime        @db.Date
  amountOriginal Decimal         @db.Decimal(10, 2)
  currencyCode   String
  amountIls      Decimal         @db.Decimal(10, 2)
  category       ExpenseCategory
  receiptUrl     String?
  notes          String?
  enteredById    String
  createdAt      DateTime        @default(now())

  branch        Branch         @relation(fields: [branchId], references: [id])
  currency      Currency       @relation(fields: [currencyCode], references: [code])
  enteredBy     User           @relation(fields: [enteredById], references: [id])
  stockMovement StockMovement?
  campaign      Campaign?
}

model Supplier {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  stockMovements StockMovement[]
}

model StockItem {
  id                String   @id @default(cuid())
  name              String
  nameAr            String?
  unit              Unit
  lowStockThreshold Decimal  @db.Decimal(10, 2)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())

  locationStock     LocationStock[]
  stockMovements    StockMovement[]
  stockRequestItems StockRequestItem[]
}

/// A place stock physically sits: either a warehouse (branchId null) or a branch.
model StockLocation {
  id        String            @id @default(cuid())
  name      String
  nameAr    String?
  type      StockLocationType
  branchId  String?
  isActive  Boolean           @default(true)
  createdAt DateTime          @default(now())

  branch            Branch?         @relation(fields: [branchId], references: [id])
  locationStock     LocationStock[]
  stockMovements    StockMovement[]
  requestsMade      StockRequest[]  @relation("StockRequestRequestingLocation")
  requestsFulfilled StockRequest[]  @relation("StockRequestFulfillingLocation")
}

model LocationStock {
  id              String  @id @default(cuid())
  locationId      String
  stockItemId     String
  currentQuantity Decimal @default(0) @db.Decimal(10, 2)
  /// Per-location reorder point. Overrides StockItem.lowStockThreshold when > 0.
  minimumQuantity Decimal @default(0) @db.Decimal(10, 2)

  location  StockLocation @relation(fields: [locationId], references: [id])
  stockItem StockItem     @relation(fields: [stockItemId], references: [id])

  @@unique([locationId, stockItemId])
}

model StockMovement {
  id          String               @id @default(cuid())
  locationId  String
  stockItemId String
  type        StockMovementType
  direction   AdjustmentDirection?
  quantity    Decimal              @db.Decimal(10, 2)
  costIls     Decimal?             @db.Decimal(10, 2)
  supplierId  String?
  expenseId   String?              @unique
  notes       String?
  date        DateTime             @db.Date
  enteredById String
  createdAt   DateTime             @default(now())

  location  StockLocation @relation(fields: [locationId], references: [id])
  stockItem StockItem     @relation(fields: [stockItemId], references: [id])
  supplier  Supplier?     @relation(fields: [supplierId], references: [id])
  enteredBy User          @relation(fields: [enteredById], references: [id])
  expense   Expense?      @relation(fields: [expenseId], references: [id])
}

model StockRequest {
  id                   String             @id @default(cuid())
  requestingLocationId String
  fulfillingLocationId String
  status               StockRequestStatus @default(PENDING)
  requestedById        String
  reviewedById         String?
  notes                String?
  createdAt            DateTime           @default(now())
  reviewedAt           DateTime?

  requestingLocation StockLocation      @relation("StockRequestRequestingLocation", fields: [requestingLocationId], references: [id])
  fulfillingLocation StockLocation      @relation("StockRequestFulfillingLocation", fields: [fulfillingLocationId], references: [id])
  requestedBy        User               @relation("StockRequestRequester", fields: [requestedById], references: [id])
  reviewedBy         User?              @relation("StockRequestReviewer", fields: [reviewedById], references: [id])
  items              StockRequestItem[]
}

model StockRequestItem {
  id                String   @id @default(cuid())
  stockRequestId    String
  stockItemId       String
  quantityRequested Decimal  @db.Decimal(10, 2)
  quantityFulfilled Decimal? @db.Decimal(10, 2)

  stockRequest StockRequest @relation(fields: [stockRequestId], references: [id], onDelete: Cascade)
  stockItem    StockItem    @relation(fields: [stockItemId], references: [id])
}

model Employee {
  id        String           @id @default(cuid())
  name      String
  phone     String?
  branchId  String
  position  EmployeePosition
  salaryIls Decimal          @db.Decimal(10, 2)
  startDate DateTime         @db.Date
  isActive  Boolean          @default(true)
  notes     String?
  createdAt DateTime         @default(now())

  branch           Branch            @relation(fields: [branchId], references: [id])
  shiftAssignments ShiftAssignment[]
}

model ShiftAssignment {
  id         String    @id @default(cuid())
  employeeId String
  date       DateTime  @db.Date
  shift      ShiftType
  notes      String?

  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, date])
}

model Task {
  id           String       @id @default(cuid())
  title        String
  description  String?
  branchId     String?
  assignedToId String?
  status       TaskStatus   @default(TODO)
  priority     TaskPriority @default(MEDIUM)
  dueDate      DateTime?    @db.Date
  createdById  String
  createdAt    DateTime     @default(now())
  completedAt  DateTime?

  branch     Branch? @relation(fields: [branchId], references: [id])
  assignedTo User?   @relation("TaskAssignee", fields: [assignedToId], references: [id])
  createdBy  User    @relation("TaskCreator", fields: [createdById], references: [id])
}

model Document {
  id           String           @id @default(cuid())
  title        String
  category     DocumentCategory
  branchId     String?
  fileUrl      String
  expiryDate   DateTime?        @db.Date
  notes        String?
  uploadedById String
  createdAt    DateTime         @default(now())

  branch     Branch? @relation(fields: [branchId], references: [id])
  uploadedBy User    @relation(fields: [uploadedById], references: [id])
}

model Campaign {
  id          String          @id @default(cuid())
  name        String
  description String?
  branchId    String?
  startDate   DateTime        @db.Date
  endDate     DateTime        @db.Date
  budgetIls   Decimal?        @db.Decimal(10, 2)
  channel     CampaignChannel
  notes       String?
  expenseId   String?         @unique
  createdAt   DateTime        @default(now())

  branch  Branch?  @relation(fields: [branchId], references: [id])
  expense Expense? @relation(fields: [expenseId], references: [id])
}

model MenuExperiment {
  id          String           @id @default(cuid())
  productName String
  notes       String
  status      ExperimentStatus @default(IDEA)
  branchId    String?
  createdAt   DateTime         @default(now())

  branch Branch? @relation(fields: [branchId], references: [id])
}

model Feedback {
  id        String            @id @default(cuid())
  branchId  String
  date      DateTime          @db.Date
  source    FeedbackSource
  sentiment FeedbackSentiment
  content   String
  createdAt DateTime          @default(now())

  branch Branch @relation(fields: [branchId], references: [id])
}
