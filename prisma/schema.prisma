generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  MANAGER
  STAFF
}

enum ProductCategory {
  BUBBLE_TEA
  COFFEE
  FOOD
  OTHER
}

enum ExpenseCategory {
  RENT
  SUPPLIES
  SALARY
  MARKETING
  EQUIPMENT
  OTHER
}

enum Unit {
  KG
  G
  L
  ML
  PIECE
  PACK
}

enum StockMovementType {
  PURCHASE
  CONSUMPTION
  WASTE
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
}

enum AdjustmentDirection {
  INCREASE
  DECREASE
}

enum EmployeePosition {
  BARISTA
  CASHIER
  SHIFT_LEAD
  BRANCH_MANAGER
  CLEANER
  OTHER
}

enum ShiftType {
  MORNING
  EVENING
  FULL_DAY
}

model Branch {
  id        String   @id @default(cuid())
  name      String
  location  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  users          User[]
  branchProducts BranchProduct[]
  salesEntries   SalesEntry[]
  expenses       Expense[]
  branchStock    BranchStock[]
  stockMovements StockMovement[]
  employees      Employee[]
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(STAFF)
  branchId     String?
  createdAt    DateTime @default(now())

  branch         Branch?         @relation(fields: [branchId], references: [id])
  salesEntries   SalesEntry[]
  expenses       Expense[]
  stockMovements StockMovement[]
}

model Product {
  id           String          @id @default(cuid())
  name         String
  nameAr       String?
  category     ProductCategory
  basePriceIls Decimal         @db.Decimal(10, 2)
  costIls      Decimal?        @db.Decimal(10, 2)
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())

  branchProducts BranchProduct[]
  salesLineItems SalesLineItem[]
}

model BranchProduct {
  id               String   @id @default(cuid())
  branchId         String
  productId        String
  isAvailable      Boolean  @default(true)
  priceOverrideIls Decimal? @db.Decimal(10, 2)

  branch  Branch  @relation(fields: [branchId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([branchId, productId])
}

model Currency {
  code      String   @id
  rateToIls Decimal  @db.Decimal(10, 4)
  updatedAt DateTime @updatedAt

  expenses             Expense[]
  salesCurrencyAmounts SalesCurrencyAmount[]
}

model SalesEntry {
  id          String   @id @default(cuid())
  branchId    String
  date        DateTime @db.Date
  totalIls    Decimal  @db.Decimal(10, 2)
  orderCount  Int
  notes       String?
  enteredById String
  createdAt   DateTime @default(now())

  branch          Branch                @relation(fields: [branchId], references: [id])
  enteredBy       User                  @relation(fields: [enteredById], references: [id])
  lineItems       SalesLineItem[]
  currencyAmounts SalesCurrencyAmount[]

  @@unique([branchId, date])
}

model SalesLineItem {
  id           String @id @default(cuid())
  salesEntryId String
  productId    String
  quantity     Int

  salesEntry SalesEntry @relation(fields: [salesEntryId], references: [id])
  product    Product    @relation(fields: [productId], references: [id])
}

model SalesCurrencyAmount {
  id             String  @id @default(cuid())
  salesEntryId   String
  currencyCode   String
  amountOriginal Decimal @db.Decimal(10, 2)
  amountIls      Decimal @db.Decimal(10, 2)

  salesEntry SalesEntry @relation(fields: [salesEntryId], references: [id])
  currency   Currency   @relation(fields: [currencyCode], references: [code])

  @@unique([salesEntryId, currencyCode])
}

model Expense {
  id             String          @id @default(cuid())
  branchId       String
  date           DateTime        @db.Date
  amountOriginal Decimal         @db.Decimal(10, 2)
  currencyCode   String
  amountIls      Decimal         @db.Decimal(10, 2)
  category       ExpenseCategory
  receiptUrl     String?
  notes          String?
  enteredById    String
  createdAt      DateTime        @default(now())

  branch        Branch         @relation(fields: [branchId], references: [id])
  currency      Currency       @relation(fields: [currencyCode], references: [code])
  enteredBy     User           @relation(fields: [enteredById], references: [id])
  stockMovement StockMovement?
}

model Supplier {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  stockMovements StockMovement[]
}

model StockItem {
  id                String   @id @default(cuid())
  name              String
  nameAr            String?
  unit              Unit
  lowStockThreshold Decimal  @db.Decimal(10, 2)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())

  branchStock    BranchStock[]
  stockMovements StockMovement[]
}

model BranchStock {
  id              String  @id @default(cuid())
  branchId        String
  stockItemId     String
  currentQuantity Decimal @default(0) @db.Decimal(10, 2)

  branch    Branch    @relation(fields: [branchId], references: [id])
  stockItem StockItem @relation(fields: [stockItemId], references: [id])

  @@unique([branchId, stockItemId])
}

model StockMovement {
  id          String               @id @default(cuid())
  branchId    String
  stockItemId String
  type        StockMovementType
  direction   AdjustmentDirection?
  quantity    Decimal              @db.Decimal(10, 2)
  costIls     Decimal?             @db.Decimal(10, 2)
  supplierId  String?
  expenseId   String?              @unique
  notes       String?
  date        DateTime             @db.Date
  enteredById String
  createdAt   DateTime             @default(now())

  branch    Branch    @relation(fields: [branchId], references: [id])
  stockItem StockItem @relation(fields: [stockItemId], references: [id])
  supplier  Supplier? @relation(fields: [supplierId], references: [id])
  enteredBy User      @relation(fields: [enteredById], references: [id])
  expense   Expense?  @relation(fields: [expenseId], references: [id])
}

model Employee {
  id         String           @id @default(cuid())
  name       String
  phone      String?
  branchId   String
  position   EmployeePosition
  salaryIls  Decimal          @db.Decimal(10, 2)
  startDate  DateTime         @db.Date
  isActive   Boolean          @default(true)
  notes      String?
  createdAt  DateTime         @default(now())

  branch           Branch            @relation(fields: [branchId], references: [id])
  shiftAssignments ShiftAssignment[]
}

model ShiftAssignment {
  id         String    @id @default(cuid())
  employeeId String
  date       DateTime  @db.Date
  shift      ShiftType
  notes      String?

  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, date])
}
